var hadal = bedrock.lt(-6000).selfMask();
Map.addLayer(hadal,{palette: ['purple']}, 'Hadal Zone');

var abyssal = bedrock.gt(-6000)
.and(bedrock.lt(-3000))
.selfMask();
Map.addLayer(abyssal,{palette: ['darkblue']}, 'Abyssal plains');

var continental_slopes = bedrock.gt(-3000)
.and(bedrock.lt(-250))
.selfMask();
Map.addLayer(continental_slopes,{palette: ['yellow']}, 'Continental slopes');


// Need to incoperate slope > 6 degrees
//var submarine_canyons = bedrock.gt(0)
var slope = ee.Terrain.slope(bedrock);
var submarine_canyons = slope.updateMask(slope.gt(6));
Map.addLayer(submarine_canyons,{palette : ['orange']},'Submarine canyons');

