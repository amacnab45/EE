// Loading in ETOPO1 dataset


var bedrock = ee.Image("NOAA/NGDC/ETOPO1")
.select('bedrock');  //Dont forget the quotation marks

Map.addLayer(bedrock,{
  min : -8000,
  max : 4000,
palette : ['darkblue','blue','cyan','green','yellow']}, 'Bedrock'); //Palette assigns colours to features


//Centers the map
Map.setCenter(0,0,2)
//Satellite mode
Map.setOptions('Satellite');


//var ocean = bedrock.lt(0); // lt stands for less than 
//Map.addLayer(ocean, {}, 'Ocean');

//Represents the ocean as blue and land transperant
//var ocean = bedrock.lt(0).selfMask();
//Map.addLayer(ocean, {palette : ['blue']}, 'Ocean');


var hadal = bedrock.lt(-6000).selfMask();
Map.addLayer(hadal,{palette: ['purple']}, 'Hadal Zone');

var abyssal = bedrock.gt(-6000)
.and(bedrock.lt(-3000))
.selfMask();
Map.addLayer(abyssal,{palette: ['darkblue']}, 'Abyssal plains');

var continental_slopes = bedrock.gt(-3000)
.and(bedrock.lt(-250))
.selfMask();
Map.addLayer(continental_slopes,{palette: ['pink']}, 'Continental slopes');


// Need to incoperate slope > 6 degrees
//var submarine_canyons = bedrock.gt(0)
var slope = ee.Terrain.slope(bedrock);
var submarine_canyons = slope.updateMask(slope.gt(6));
Map.addLayer(submarine_canyons,{palette : ['orange']},'Submarine canyons');

var reef = ee.Image("ACA/reef_habitat/v2_0");
//Map.addLayer(reef,{palette : ['cyan']}, 'Coral reefs')
//print(reef.bandNames());
Map.addLayer(reef.select('reef_mask').selfMask(),
{palette : 'pink'}, 'Coral reefs');

var boats = ee.ImageCollection("GFW/GFF/V1/vessel_hours")
.filterDate('2016-01-01', '2017-01-01')







// Separating the fishing practices

var longlines = boats.select('drifting_longlines').sum();
var fixed_gear = boats.select('fixed_gear').sum();
var  other = boats.select('other_fishing').sum();
var purse_seines = boats.select('purse_seines').sum();
var squid_jigger = boats.select('squid_jigger').sum();
var trawlers = boats.select('trawlers').sum();

//Hides zero values 
var longlines_masked = longlines.selfMask();


Map.addLayer(longlines_masked, {
  min: 0,
  max: 10,
  palette : ['yellow', 'orange','red']
}, 'Global Longlines');

